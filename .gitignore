# Background contact sheets (regenerate: tools/background_contact_sheet.py)
_audit/backgrounds/

# Ken Burns per-frame traces (regenerate: tools/kenburns_trace.py)
_audit/kenburns/
logs/

# Pexels download cache. Regenerable by definition — topic_clips re-fetches
# any missing query — and 453 MB of stock mp4 has no business in history.
# The clips a video actually uses are hardlinked into its own artifact
# directory under output/, which is already ignored.
assets/clips/_cache/

# Audit EVIDENCE — renders, contact sheets, frame dumps. 183 MB of PNG and
# MP4 that document a finding once and are never read by code. The audit
# MARKDOWN is tracked; the pictures it refers to are not, because a binary
# blob in git history is permanent and cannot be removed without rewriting
# every commit after it.
_audit/**/*.png
_audit/**/*.jpg
_audit/**/*.jpeg
_audit/**/*.mp4
_audit/**/*.mov
_to_delete/

# Manim studio (experiments/manim_voiceover_poc/) — the GENERATED half.
#
# NOT `experiments/**/renders/` as a whole: the .youtube.md publishing notes
# live in renders/<lesson>/ beside the video they describe and ARE tracked
# (73d23d0). Ignoring the directory would silently stop `git add` from ever
# seeing a new one, so the generated things are named individually instead.
#
# media/ is Manim's own cache — SVG glyph dumps and a voiceover cache.json,
# 112 files it rebuilds on demand.
experiments/**/media/
experiments/**/renders/jobs/
experiments/**/renders/**/*.mp4
experiments/**/renders/**/*.jpg

# Scratch tree for things handed back in chat. Never an input to the build.
Claude outputs/
