# ============================================
# English AI Videos - Environment Configuration
# ============================================
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
#
# SECURITY: Never commit .env to version control!
# ============================================

# ── REQUIRED ──────────────────────────────────
# OpenRouter is the only paid AI: script, voice (ElevenLabs eleven-v4), word timings and
# illustrations. Keep the key and the voice in the Keychain rather than here:
#   security add-generic-password -s english-ai-videos -a OPENROUTER_API_KEY -w
#   security add-generic-password -s english-ai-videos -a OPENROUTER_VOICE_ID -w
# OPENROUTER_API_KEY=
# OPENROUTER_VOICE_ID=

# The channel's voice id, sent with every voice request (OpenRouter speaks with OPENROUTER_VOICE_ID).
ELEVENLABS_VOICE_ID=tu_voice_id_aqui
CHILDREN_ELEVENLABS_VOICE_ID=
YOUTUBE_ADULTS_ELEVENLABS_VOICE_ID=
YOUTUBE_CHILDREN_ELEVENLABS_VOICE_ID=
BILIBILI_ADULTS_ELEVENLABS_VOICE_ID=
BILIBILI_CHILDREN_ELEVENLABS_VOICE_ID=

# ── BACKGROUNDS / STOCK FOOTAGE ──────────────
# Pexels video search, for the moving clip backgrounds (src/topic_clips.py).
# Free, no subscription: 200 requests/hour, 20,000/month.
# Get yours at: https://www.pexels.com/api/
# Leave empty and the clip tier declines quietly; the pipeline falls through
# to the generated-image tier, so an absent key costs a background, not a run.
PEXELS_API_KEY=

# ── SOCIAL MEDIA UPLOADS ─────────────────────
# TikTok Content Posting API
# Register at: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# YouTube Data API v3
# Create credentials at: https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Meta Reels publisher (README, "Meta Reels"). Instagram and Facebook both publish
# through the Page: a long-lived Page access token (Instagram API with Facebook Login).
FB_PAGE_ID=
FB_PAGE_TOKEN=
# Optional: only compared with the Page's linked Instagram account by setup-check.
IG_USER_ID=

# Brevo (email). Create at: app.brevo.com > SMTP & API > API keys
BREVO_API_KEY=
