  "segments": [
    {
      "start": 0.0,
      "end": 3.425,
      "text": "Te ofrecen entradas gratis para tu grupo favorito."
    },
    {
      "start": 3.75,
      "end": 4.807,
      "text": "¿Lo piensas?"
    },
    {
      "start": 5.248,
      "end": 5.782,
      "text": "No."
    },
    {
      "start": 6.06,
      "end": 8.557,
      "text": "Eso en inglés es un no-brainer."
    },
    {
      "start": 8.766,
      "end": 11.204,
      "text": "Literalmente, un sin-cerebro."
    },
    {
      "start": 11.529,
      "end": 14.218,
      "text": "Algo tan obvio que no hace falta pensarlo."
    },
    {
      "start": 14.901,
      "end": 16.447,
      "text": "That's a no-brainer."
    },
    {
      "start": 17.078,
      "end": 18.448,
      "text": "Está clarísimo."
    },
    {
      "start": 18.622,
      "end": 21.397,
      "text": "Se usa muchísimo en reuniones de trabajo."
    },
    {
      "start": 21.606,
      "end": 24.706,
      "text": "Suena a que la decisión es evidente para todos."
    },
    {
      "start": 24.88,
      "end": 27.329,
      "text": "También sirve para empujar una idea."
    },
    {
      "start": 27.847,
      "end": 29.583,
      "text": "It's a no-brainer, really."
    },
    {
      "start": 29.977,
      "end": 32.044,
      "text": "Vamos, que no hay ni que pensarlo."
    },
    {
      "start": 32.218,
      "end": 34.986,
      "text": "Si quieres decir lo contrario, hay una frase natural."
    },
    {
      "start": 35.405,
      "end": 36.856,
      "text": "It's a tough call."
    },
    {
      "start": 37.489,
      "end": 39.045,
      "text": "Es una decisión difícil."
    },
    {
      "start": 39.172,
      "end": 42.645,
      "text": "Y si estás partido por la mitad, di I'm torn."
    },
    {
      "start": 42.947,
      "end": 44.421,
      "text": "Estoy dividido."
    },
    {
