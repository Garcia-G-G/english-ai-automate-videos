{
  "name": "English Unlimited",
  "version": "v2 pegatina",
  "tagline": "El inglés que usas cada día, explicado en español.",
  "color": {
    "brand_yellow": "#F2D66B",
    "english_blue": "#1B6FA8",
    "ink": "#1C1812",
    "paper": "#FEFDFB",
    "sky": "#9AD1F0",
    "correct": "#2F8F5B",
    "error": "#C0453A",
    "secondary_text": "#6D665B"
  },
  "font": {
    "display": {
      "family": "Fredoka",
      "weight": 700,
      "file": "assets/fonts/Fredoka-Bold.ttf"
    },
    "display_medium": {
      "family": "Fredoka",
      "weight": 500,
      "file": "assets/fonts/Fredoka-Medium.ttf"
    },
    "body": {
      "family": "Manrope",
      "weight": 500,
      "file": "assets/fonts/Manrope[wght].ttf"
    }
  },
  "sticker": {
    "outline_px": [
      7,
      10
    ],
    "outline_color": "#1C1812",
    "shadow_offset_px": [
      8,
      8
    ],
    "shadow_blur": 0,
    "rotation_deg": [
      -8,
      8
    ]
  },
  "rules": {
    "english_is_blue": true,
    "max_yellow_stickers_per_sentence": 1,
    "min_symbol_px": 40
  }
}